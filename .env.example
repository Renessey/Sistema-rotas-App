APP_ENV=production

# Token Público de Acesso da API Mapbox (Plano Gratuito: 100.000 requisições/mês)
# Cota interna diária segura: 3.000 requisições/dia com reset automático à meia-noite
# Obtenha seu token em: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.seu_token_aqui_obtenha_no_site_do_mapbox
